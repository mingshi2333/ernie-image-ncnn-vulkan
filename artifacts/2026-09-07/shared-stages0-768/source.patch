+def stage_weight_source(model, saved, binding):
+    """Resolve DiT provenance after reference_package authenticates the oracle."""
+    def object_manifest(digest):
+        if not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest):
+            raise ValueError('Invalid official weight provenance digest')
+        path = model/'objects'/digest
+        if path.is_symlink() or path.stat().st_size > 4*1024*1024 or sha256(path) != digest:
+            raise ValueError('Official weight provenance object differs')
+        manifest = json.loads(path.read_text())
+        if manifest.get('schema_version') != 2 or manifest.get('portable') is not True:
+            raise ValueError('Official weight provenance requires a portable source')
+        return manifest
+
+    source = (object_manifest(binding['source_manifest_sha256']) if binding is not None
+              else json.loads((model/'manifest.json').read_text()))
+    weights = source.get('source_weights')
+    provenance = None
+    if not weights and binding is not None:
+        provenance = saved.get('runtime_source', {}).get('official_weight_provenance', {})
+        donor = object_manifest(provenance.get('source_manifest_sha256'))
+        def assets(manifest):
+            return {name: digest for name, digest in manifest['files'].items()
+                    if name != 'model.cfg' and not name.endswith('.param')}
+        original = assets(source)
+        if (original != assets(donor) or len(original) != provenance.get('identical_runtime_assets')
+                or source.get('official_model_revision') != donor.get('official_model_revision')):
+            raise ValueError('Official weight provenance has different runtime assets')
+        weights = donor.get('source_weights')
+    blocks = weights.get('dit') if isinstance(weights, dict) else None
+    if (not isinstance(blocks, list) or len(blocks) != 36 or
+            any(not isinstance(value, str) or not re.fullmatch('[0-9a-f]{64}', value) for value in blocks)):
+        raise ValueError('Require all 36 official DiT weight digests')
+    return blocks, provenance
+
